{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "glasshouse",
  "version": "0.2.0",
  "identifier": "io.github.johnson-anthony.glasshouse",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "glasshouse",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "fullscreen": false,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Anthony Johnson",
    "copyright": "Copyright (c) 2026 Anthony Johnson",
    "homepage": "https://johnson-anthony.github.io/glasshouse/",
    "category": "Utility",
    "shortDescription": "A file manager for Windows and Linux",
    "longDescription": "A desktop file manager with tabs, a built-in terminal, git status for every file, previews, archives and bulk rename. It can open folders for other apps, and on Linux be their open and save dialog.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "installerHooks": "windows/hooks.nsh" },
      "wix": {
        "upgradeCode": "d5dc81dc-7659-5d8f-825d-74a5dc726d43",
        "fragmentPaths": ["windows/integration.wxs"],
        "componentGroupRefs": ["GlasshouseIntegration"]
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "recommends": ["git", "7zip | p7zip-full", "xdg-utils"],
        "desktopTemplate": "linux/glasshouse.desktop",
        "files": {
          "/usr/share/xdg-desktop-portal/portals/glasshouse.portal": "linux/glasshouse.portal",
          "/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.glasshouse.service": "linux/org.freedesktop.impl.portal.desktop.glasshouse.service"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwMTE5RDUyM0FFRDc5RTIKUldUaWVlMDZVcDBSSUpnSTdqeGN4T2lPY01ENUNWWWpmWmluR3hUMzRlL1oyYkFuMytuTitDbXUK",
      "endpoints": ["https://github.com/Johnson-Anthony/glasshouse/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
